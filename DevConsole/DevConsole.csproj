<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OverThink ICeZeRoX\OverThink ICeZeRoX.csproj" />
    <ProjectReference Include="..\XaocSirck Core\XaocSirck Core.csproj" />
    <Content Include="..\XSRule_Test.xsr" Link="XSRule_Test.xsr">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="dev_console_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyNativeDlls" AfterTargets="Build">
    <ItemGroup>
      <NativeDll Include="..\XaocSirck Inference Service\x64\Release\XaocSirck Inference Service.dll" />
      <NativeDll Include="..\XaocSirck Online Service\x64\Release\XaocSirck Online Service.dll" />
      <NativeDll Include="D:\VCpkg\installed\x64-windows\bin\onnxruntime.dll" />
      <NativeDll Include="D:\VCpkg\installed\x64-windows\bin\DirectML.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishAndCopyExport" AfterTargets="Build">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\XaocSirck Export\XaocSirck Export.csproj&quot; -c $(Configuration) -r win-x64 --self-contained" />
    <ItemGroup>
      <ExportFiles Include="..\XaocSirck Export\bin\$(Configuration)\net10.0-windows10.0.26100.0\win-x64\publish\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ExportFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
